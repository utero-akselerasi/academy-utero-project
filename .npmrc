# `engines` di package.json tanpa berkas ini hanya peringatan: npm mencetak
# WARN lalu memasang paket apa adanya. Dengan `engine-strict`, versi Node yang
# tidak memenuhi syarat menggagalkan install — sehingga ketidakcocokan muncul
# saat install, bukan sebagai bug runtime yang tidak jelas asalnya.
#
# Terverifikasi: dari 110 paket di lockfile yang mendeklarasikan `engines.node`,
# tidak ada satu pun yang menolak Node 24.
engine-strict=true

# `npm ci` dan `npm install` tidak menulis skrip lifecycle apa pun dari paket
# pihak ketiga tanpa persetujuan. Skrip `postinstall` adalah jalur eksekusi kode
# arbitrer saat install — jalur yang dipakai hampir setiap serangan rantai pasok
# npm. Kalau suatu paket benar-benar butuh build step (mis. `sharp`), izinkan
# secara eksplisit per paket, bukan dengan membuka semuanya.
ignore-scripts=true
