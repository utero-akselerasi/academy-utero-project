ACADEMY_POSTGRES_PASSWORD=replace-with-strong-secret
ACADEMY_API_PASSWORD=replace-with-different-strong-secret
ACADEMY_STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-characters
ACADEMY_MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-strong-secret@postgres:5432/academy
ACADEMY_API_DATABASE_URL=postgresql://academy_api:replace-with-different-strong-secret@postgres:5432/academy
ACADEMY_BACKEND_SUBNET=10.254.89.0/24
ACADEMY_HTTP_PORT=9982
ACADEMY_SECURE_COOKIES=true
NEXT_PUBLIC_APP_URL=https://academy.example.com
PUBLIC_APP_URL=https://academy.example.com

# Migration profile; confirmation values stay blank until an operator starts a controlled copy.
SOURCE_DATABASE_URL=
CONFIRM_USER_PROFILE_COPY=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
CONFIRM_BOOTSTRAP_SUPER_ADMIN=
STORAGE_IMPORT_SOURCE=./storage-import
CONFIRM_DATABASE_COPY=
CONFIRM_STORAGE_IMPORT=

# Operations profile; set names per backup or restore invocation.
BACKUP_NAME=
RESTORE_BACKUP_NAME=
CONFIRM_RESTORE=
ACADEMY_OFFSITE_BACKUP_ROOT=/mnt/offsite/academy-backups
RETENTION_DAYS=30
RETENTION_MINIMUM_KEEP=7
CONFIRM_PRUNE=
OPS_HEALTH_TIMEOUT_MS=5000
OPS_MINIMUM_FREE_PERCENT=15
OPS_MAXIMUM_BACKUP_AGE_HOURS=26
ACADEMY_LOG_MAX_SIZE=10m
ACADEMY_LOG_MAX_FILES=5
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Utero Academy <noreply@example.com>

# Akun uji cutover. Gunakan akun nonproduksi dengan tiap role yang disebut.
SMOKE_DEFAULT_PASSWORD=
SMOKE_SUPER_ADMIN_EMAIL=
SMOKE_SUPER_ADMIN_PASSWORD=
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_SCHOOL_EMAIL=
SMOKE_SCHOOL_PASSWORD=
SMOKE_INTERN_EMAIL=
SMOKE_INTERN_PASSWORD=
SMOKE_APPLICANT_EMAIL=
SMOKE_APPLICANT_PASSWORD=
