# Copy to an operator-owned env file outside version control. Never commit real values.
ACADEMY_POSTGRES_PASSWORD=
ACADEMY_API_PASSWORD=
ACADEMY_STORAGE_SIGNING_SECRET=

ACADEMY_MIGRATION_DATABASE_URL=postgresql://postgres:<postgres-password>@postgres:5432/academy
ACADEMY_API_DATABASE_URL=postgresql://academy_api:<api-password>@postgres:5432/academy
ACADEMY_BACKEND_SUBNET=10.254.89.0/24

# Only Nginx is published. Keep 3000, 3001, and 5432 closed on the host firewall.
ACADEMY_HTTP_BIND_ADDRESS=0.0.0.0
ACADEMY_HTTP_PORT=80
ACADEMY_HTTPS_BIND_ADDRESS=0.0.0.0
ACADEMY_HTTPS_PORT=443

# Directory must contain fullchain.pem and privkey.pem before startup.
ACADEMY_TLS_CERT_DIR=/absolute/path/to/tls
ACADEMY_ACME_CHALLENGE_DIR=./data/acme

# Replace with the real canonical HTTPS URL. No trailing slash.
NEXT_PUBLIC_APP_URL=
PUBLIC_APP_URL=
ACADEMY_SECURE_COOKIES=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Migration only. Keep confirmations empty during normal runtime.
SOURCE_DATABASE_URL=
CONFIRM_USER_PROFILE_COPY=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
CONFIRM_BOOTSTRAP_SUPER_ADMIN=
STORAGE_IMPORT_SOURCE=
CONFIRM_DATABASE_COPY=
CONFIRM_STORAGE_IMPORT=

# Operations, capacity, and off-host backup.
ACADEMY_OFFSITE_BACKUP_ROOT=/mnt/academy-offsite-backups
OPS_MINIMUM_FREE_PERCENT=15
OPS_MAXIMUM_BACKUP_AGE_HOURS=26
OPS_HEALTH_TIMEOUT_MS=5000
OPS_HEALTH_OUTPUT=/evidence/ops-health.json
ACADEMY_LOG_MAX_SIZE=10m
ACADEMY_LOG_MAX_FILES=5

# Dedicated production smoke accounts. Never use personal operator accounts.
SMOKE_SUPER_ADMIN_EMAIL=
SMOKE_SUPER_ADMIN_PASSWORD=
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_SCHOOL_EMAIL=
SMOKE_SCHOOL_PASSWORD=
SMOKE_INTERN_EMAIL=
SMOKE_INTERN_PASSWORD=
SMOKE_APPLICANT_EMAIL=
SMOKE_APPLICANT_PASSWORD=
